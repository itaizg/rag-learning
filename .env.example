# .env.example — copy this to .env and fill in your keys
# Claude Code reads this template but will NOT write real keys anywhere.

# Anthropic (primary SDK for agent/RAG/eval notebooks 13, 16, 18–27)
ANTHROPIC_API_KEY=your_key_here

# OpenAI (used for side-by-side comparison cells)
OPENAI_API_KEY=your_key_here

# Hugging Face (required for local model notebooks 08, 10, P1)
HF_TOKEN=your_token_here

# Pinecone (optional, used in notebook 15 — vector databases)
PINECONE_API_KEY=your_key_here
PINECONE_ENV=your_environment_here

# LangSmith (optional, used in notebooks 20-23 and the P3 capstone — agent tracing)
LANGSMITH_API_KEY=your_key_here
LANGSMITH_PROJECT=ai-learning-notebooks
# LANGCHAIN_TRACING_V2=true   # uncomment to auto-trace LangChain/LangGraph runs to LangSmith

# RAG learning notebooks (07_rag_learning) — local/offline backend config
RAG_BACKEND=claude
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=helios-rag-2025
OLLAMA_HOST=http://localhost:11434

# Embedding backend (optional, used in notebook 14 — RAG fundamentals)
# EMBED_BACKEND=local   # local (MiniLM, offline, default) | voyage (production, needs key below)
VOYAGE_API_KEY=your_key_here
